## configuration of Round-Robin debugger for Diameter

## Diameter protocol parameter
# local host: [(tcp|sctp)://][realm/]hostname[:port]
# (default: hostname of this host)
LOCAL_ADDR=

# peer host: [realm/]hostname[:port]
PEER_ADDR0=peer.internal:3868
PEER_ADDR1=
PEER_ADDR2=
PEER_ADDR3=
PEER_ADDR4=
PEER_ADDR5=
PEER_ADDR6=
PEER_ADDR7=
PEER_ADDR8=
PEER_ADDR9=

# dictionary file path
# default: dictionary.xml
DICTIONARY=dictionary.xml

# request timeout time of second (default: 30)
TIMEOUT=30

## API parameter
# local API listening address
LOCALAPI_ADDR=localhost:8080

# backend API peer address
BACKENDAPI_ADDR=localhost:8080

# verbose log output: yes|no (default: no)
VERBOSE=yes
